{
  "Paths": {
    "train_script": "train/train_step.py",
    "train_manifest": "data_pipeline/artifacts/phase1_smoke/manifest.json",
    "eval_manifest": "data_pipeline/artifacts/phase1_smoke/manifest.json",
    "checkpoint_dir": "train/checkpoints_local_rtx3050_4gb_three_phase",
    "run_log": "train/local_rtx3050_4gb_three_phase.jsonl",
    "resume_from": null
  },
  "Hardware_Profile": {
    "device": "cuda",
    "precision": "fp16",
    "data_workers": 0,
    "prefetch_factor": 2,
    "persistent_workers": false,
    "prefetch_to_device": false
  },
  "Model_Architecture": {
    "architecture_kind": "three_phase",
    "vocab_size": 32000,
    "d_model": 256,
    "n_layers": 8,
    "encoder_layers": 4,
    "decoder_layers": 4,
    "n_heads": 8,
    "n_kv_heads": 2,
    "max_seq_len": 128,
    "dropout": 0.0,
    "gradient_checkpointing": true,
    "ffn_dim": 768,
    "ffn_kind": "swiglu",
    "gqa_layers": 0,
    "lightning_end_layer": 8,
    "mla_latent_dim": 64,
    "imagination_num_latents": 8,
    "imagination_steps": 3,
    "imagination_heads": 8,
    "imagination_ffn_dim": 768,
    "imagination_anchor_alpha": 0.1,
    "imagination_aux_alpha": 0.05,
    "imagination_stability_alpha": 0.025,
    "imagination_consistency_alpha": 0.025
  },
  "Training_Hyperparams": {
    "total_steps": 100,
    "chunk_steps": 20,
    "save_every": 20,
    "log_every": 5,
    "eval_every": 20,
    "eval_batches": 4,
    "eval_batch_size": 1,
    "optimizer": "muon",
    "micro_batch_size": 1,
    "grad_accum_steps": 8,
    "lr": 0.0003,
    "warmup_steps": 10,
    "min_lr_ratio": 0.5,
    "weight_decay": 0.01,
    "clip_grad_norm": 1.0,
    "seed": 42,
    "checkpoint_keep_last": 3,
    "freeze_layers_below": 0,
    "freeze_embeddings": false,
    "freeze_final_norm": false,
    "freeze_cognitive_block": false,
    "resume_model_only": false
  },
  "Telemetry_Alerts": {
    "log_router_stats_every": 5,
    "collapse_cv_threshold": 0.75,
    "collapse_entropy_threshold": 0.15,
    "adaptive_aux_alpha": false,
    "aux_alpha_max": 0.1,
    "aux_alpha_up_mult": 1.25,
    "aux_alpha_decay": 0.98,
    "early_stop_usage_cv_threshold": 999.0,
    "early_stop_usage_cv_patience": 5,
    "stop_on_nan_eval_perplexity": true
  }
}

